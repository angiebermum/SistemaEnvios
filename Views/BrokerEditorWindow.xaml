<Window x:Class="ECS.CommissionsMailer.Views.BrokerEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Corredor" Width="860" Height="760" MinWidth="760" MinHeight="660"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindowStyle}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Datos del corredor" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="Configure destinatarios, pestañas del reporte y rebajos sin límite."
                       Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
        </StackPanel>

        <TabControl Grid.Row="1" Margin="0,18,0,0">
            <TabItem Header="Datos y asistentes">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Nombre del corredor" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox x:Name="NameTextBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Direcciones principales (Para)" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox x:Name="AddressesTextBox" Height="72" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                            <TextBlock Text="Separe varias direcciones con punto y coma, coma o salto de línea."
                                       Style="{StaticResource CaptionTextStyle}" Margin="2,4,0,0" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="ActiveCheckBox" Content="Corredor activo" IsChecked="True"
                                          Style="{StaticResource SwitchToggleButtonStyle}" />
                            <CheckBox x:Name="ReviewCheckBox" Grid.Column="2" Content="Requiere revisión" />
                            <StackPanel Grid.Column="3" Margin="18,0,0,0">
                                <TextBlock Text="Nota de revisión" Style="{StaticResource FieldLabelTextStyle}" />
                                <TextBox x:Name="ReviewNoteTextBox" TextWrapping="Wrap" AcceptsReturn="True" Height="52"
                                         IsEnabled="{Binding IsChecked, ElementName=ReviewCheckBox}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Margin="0,16,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Asistentes asociados" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="Los asistentes activos se agregan al mismo campo Para."
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="Agregar" Click="AddAssistant_Click" Style="{StaticResource CompactButtonStyle}" />
                            <Button Content="Editar" Click="EditAssistant_Click" Style="{StaticResource CompactButtonStyle}" />
                            <ToggleButton Content="Activo" Click="ToggleAssistant_Click"
                                          IsChecked="{Binding SelectedItem.IsActive, ElementName=AssistantsGrid, Mode=OneWay}"
                                          Style="{StaticResource SwitchToggleButtonStyle}" Margin="0,0,12,0" />
                            <Button Content="Quitar" Click="RemoveAssistant_Click"
                                    Style="{StaticResource DangerButtonStyle}" Margin="0" />
                        </StackPanel>
                    </Grid>
                    <DataGrid x:Name="AssistantsGrid" Grid.Row="3"
                              ItemsSource="{Binding Assistants, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedItem="{Binding SelectedAssistant, RelativeSource={RelativeSource AncestorType=Window}}"
                              RowHeight="38" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Activo" Binding="{Binding IsActive}" Width="70" />
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Correo" Binding="{Binding Email}" Width="3*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Pestañas asociadas">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Nombres exactos de pestaña" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="Una pestaña solo puede pertenecer a un corredor."
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="Agregar" Click="AddWorksheet_Click" Style="{StaticResource CompactButtonStyle}" />
                            <Button Content="Editar" Click="EditWorksheet_Click" Style="{StaticResource CompactButtonStyle}" />
                            <Button Content="Eliminar" Click="RemoveWorksheet_Click"
                                    Style="{StaticResource DangerButtonStyle}" Margin="0" />
                        </StackPanel>
                    </Grid>
                    <DataGrid x:Name="WorksheetsGrid" Grid.Row="1"
                              ItemsSource="{Binding WorksheetNames, RelativeSource={RelativeSource AncestorType=Window}}"
                              IsReadOnly="True" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Pestaña del Excel general" Binding="{Binding}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Rebajos">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Rebajos configurables" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="Cada rebajo se aplica solo a la pestaña seleccionada."
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="Agregar" Click="AddDeduction_Click" Style="{StaticResource CompactButtonStyle}" />
                            <Button Content="Editar" Click="EditDeduction_Click" Style="{StaticResource CompactButtonStyle}" />
                            <Button Content="Eliminar" Click="RemoveDeduction_Click"
                                    Style="{StaticResource DangerButtonStyle}" Margin="0" />
                        </StackPanel>
                    </Grid>
                    <DataGrid x:Name="DeductionsGrid" Grid.Row="1"
                              ItemsSource="{Binding Deductions, RelativeSource={RelativeSource AncestorType=Window}}"
                              IsReadOnly="True" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="2*" />
                            <DataGridTextColumn Header="Pestaña destino" Binding="{Binding TargetWorksheetText}" Width="140" />
                            <DataGridTextColumn Header="Monto" Binding="{Binding Amount, StringFormat=N2}" Width="110" />
                            <DataGridTextColumn Header="Moneda" Binding="{Binding CurrencyText}" Width="120" />
                            <DataGridTextColumn Header="Aplicación" Binding="{Binding ApplicationTypeText}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" IsCancel="True" />
            <Button Content="Guardar corredor" Click="Save_Click" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
