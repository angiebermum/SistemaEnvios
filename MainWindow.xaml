<Window x:Class="ECS.CommissionsMailer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ECS Envío de Correos"
        Icon="pack://application:,,,/Images/icon.ico"
        Width="1360" Height="900" MinWidth="1100" MinHeight="820"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindowStyle}"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="18,14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="108" Height="58" Background="White" CornerRadius="7" Padding="3" Margin="0,0,14,0" ClipToBounds="True">
                    <Image Stretch="Uniform" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Source>
                            <CroppedBitmap SourceRect="110 430 1060 420">
                                <CroppedBitmap.Source>
                                    <BitmapImage UriSource="pack://application:,,,/Images/icon.jpeg" CacheOption="OnLoad" />
                                </CroppedBitmap.Source>
                            </CroppedBitmap>
                        </Image.Source>
                    </Image>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="ECS Envío de Correos" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="Preparación y envío de comisiones" Style="{StaticResource PageSubtitleTextStyle}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" MaxWidth="520">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Ellipse Width="10" Height="10" Fill="{Binding OutlookStatusBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="Cuenta de envío:" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding OutlookAccountEmail}" FontWeight="SemiBold" Margin="6,0,0,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding OutlookAccountEmail}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding OutlookStatusText}" Style="{StaticResource CaptionTextStyle}"
                               TextWrapping="Wrap" TextAlignment="Right" HorizontalAlignment="Right" Margin="0,3,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <TextBlock Text="{Binding OperationText}" Style="{StaticResource CaptionTextStyle}"
                                   VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                        <Button Content="Conectar cuenta" Click="ConnectOutlook_Click" IsEnabled="{Binding IsUiEnabled}"
                                Style="{StaticResource CompactButtonStyle}" Margin="12,0,0,0"
                                ToolTip="Conecta con Outlook clásico y actualiza la cuenta de envío." />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="300" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="3*" MinWidth="350" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Plantilla del correo" Style="{StaticResource SectionTitleTextStyle}" />
                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <TextBlock Text="Asunto" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" LostFocus="EmailField_LostFocus" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock Text="Copias generales" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Height="80" Text="{Binding CommonCcText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" LostFocus="EmailField_LostFocus" />
                        <TextBlock Text="Separe direcciones con punto y coma, coma o salto de línea."
                                   Style="{StaticResource CaptionTextStyle}" Margin="2,4,0,0" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Mensaje" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox Height="174" Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" LostFocus="EmailField_LostFocus" />
                    <TextBlock Text="El texto se codifica de forma segura y conserva los saltos de línea en Outlook."
                               Style="{StaticResource CaptionTextStyle}" Margin="2,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Firma del correo" Style="{StaticResource FieldLabelTextStyle}" />
                    <Border Height="118" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="7" Padding="8">
                        <Grid>
                            <Image Source="{Binding SignaturePreview}" Stretch="Uniform" Visibility="{Binding SignaturePreviewVisibility}" />
                            <StackPanel Visibility="{Binding SignatureEmptyVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE91B;" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="{StaticResource DisabledBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding SignatureStateText}" Style="{StaticResource CaptionTextStyle}" TextAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding SignatureFileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding SignatureFileName}" Margin="0,7,0,0" />
                    <TextBlock Text="{Binding SignatureStateText}" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0" IsEnabled="{Binding IsUiEnabled}">
                        <Button Content="{Binding SignatureSelectButtonText}" Click="SelectSignature_Click" IsEnabled="{Binding IsUiEnabled}"
                                Style="{StaticResource CompactButtonStyle}" />
                        <Button Content="Quitar" Click="RemoveSignature_Click" IsEnabled="{Binding HasConfiguredSignature}"
                                Style="{StaticResource CompactButtonStyle}" Margin="0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" IsEnabled="{Binding IsUiEnabled}">
                    <TextBlock Text="Excel general de comisiones" Style="{StaticResource FieldLabelTextStyle}" />
                    <Button Content="Seleccionar Excel general" Click="SelectGeneralWorkbook_Click"
                            Style="{StaticResource CompactButtonStyle}" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding GeneralWorkbookFileName}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding GeneralWorkbookPath}" />
                    <TextBlock Text="{Binding WorkbookAnalysisText}" Style="{StaticResource CaptionTextStyle}"
                               TextWrapping="Wrap" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding GenerationStatusText}" Foreground="{StaticResource PrimaryBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding GeneratedOutputDirectory}" Style="{StaticResource CaptionTextStyle}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding GeneratedOutputDirectory}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            IsEnabled="{Binding IsUiEnabled}" Margin="16,0,0,0">
                    <Button Content="Abrir carpeta" Click="OpenGeneratedFolder_Click"
                            IsEnabled="{Binding CanOpenGeneratedFolder}" />
                    <Button Content="Generar archivos" Click="GenerateFiles_Click"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Buscar corredores o asistentes" Style="{StaticResource FieldLabelTextStyle}" />
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Busca por nombre o correo de corredor y asistente." />
            </StackPanel>
            <WrapPanel Grid.Column="1" Margin="16,20,0,0" IsEnabled="{Binding IsUiEnabled}">
                <Button Content="Agregar" Click="AddBroker_Click" />
                <Button Content="Editar" Click="EditBroker_Click" />
                <ToggleButton Content="Activo" Click="ToggleBrokerActive_Click"
                              IsChecked="{Binding IsSelectedBrokerActive, Mode=OneWay}"
                              Style="{StaticResource SwitchToggleButtonStyle}" Margin="0,0,12,0"
                              ToolTip="Activa o desactiva el corredor seleccionado" />
                <Button Content="Eliminar" Click="DeleteBroker_Click" Style="{StaticResource DangerButtonStyle}" />
                <Button Content="&#xE72C;" FontFamily="Segoe Fluent Icons" Width="38" Padding="8"
                        Click="ReloadBrokers_Click" ToolTip="Recargar corredores" />
                <Button Content="{Binding InactiveBrokersButtonText}" Click="ShowInactiveBrokers_Click"
                        Margin="0" ToolTip="Abrir la lista separada de corredores inactivos" />
            </WrapPanel>
            <TextBlock Grid.Column="2" Text="{Binding BrokerSummaryText}" Style="{StaticResource MutedTextStyle}"
                       VerticalAlignment="Bottom" Margin="12,0,0,8" />
        </Grid>

        <DataGrid x:Name="BrokersGrid" Grid.Row="4" ItemsSource="{Binding BrokerItemsView}"
                  SelectedItem="{Binding SelectedBrokerItem}" IsEnabled="{Binding IsUiEnabled}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  RowDetailsVisibilityMode="VisibleWhenSelected">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="82">
                    <DataGridCheckBoxColumn.Header>
                        <CheckBox Content="Enviar" IsThreeState="True"
                                  IsChecked="{Binding DataContext.AreAllBrokersSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}"
                                  Click="ToggleAllBrokers_Click"
                                  ToolTip="Marcar o desmarcar todos los corredores" />
                    </DataGridCheckBoxColumn.Header>
                </DataGridCheckBoxColumn>
                <DataGridTemplateColumn Header="Corredor y correo principal" Width="260">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding BrokerName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <Border Background="{StaticResource WarningBackgroundBrush}" CornerRadius="8" Padding="6,2" Margin="8,0,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers><DataTrigger Binding="{Binding RequiresReview}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="Revisión" Foreground="{StaticResource WarningBrush}" FontSize="10" FontWeight="SemiBold" ToolTip="{Binding ReviewNote}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding PrimaryRecipientsText}" Style="{StaticResource CaptionTextStyle}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding PrimaryRecipientsText}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Asistentes asociados" Width="240">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding AssistantSummary}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding AssistantTooltip}" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Excel" Width="76">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><TextBlock Text="{Binding AttachmentCountText}" ToolTip="{Binding AttachmentSummary}" /></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Estado" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusBadgeStyle}" /></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Error o advertencia" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding LastError}" TextWrapping="Wrap" MaxHeight="36" ToolTip="{Binding LastError}" Foreground="{StaticResource ErrorBrush}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Acciones" Width="*" MinWidth="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="&#xE723;" FontFamily="Segoe Fluent Icons" Width="32" Padding="4" ToolTip="Adjuntar archivos Excel"
                                        Click="AttachFiles_Click" CommandParameter="{Binding}" Style="{StaticResource CompactButtonStyle}" />
                                <Button Content="&#xE72C;" FontFamily="Segoe Fluent Icons" Width="32" Padding="4" ToolTip="Reenviar el último correo"
                                        Click="ResendRow_Click" CommandParameter="{Binding}" Style="{StaticResource CompactButtonStyle}" Margin="0" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource PrimaryLightBrush}" Padding="12" Margin="50,0,8,8" CornerRadius="7">
                        <StackPanel>
                            <TextBlock Text="Generados automáticamente" FontWeight="SemiBold" Margin="0,0,0,5" />
                            <ItemsControl ItemsSource="{Binding GeneratedAttachmentPaths}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <Button DockPanel.Dock="Right" Content="Quitar" Click="RemoveAttachment_Click"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                                    Style="{StaticResource CompactButtonStyle}" Margin="8,0,0,0" />
                                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Agregados manualmente" FontWeight="SemiBold" Margin="0,10,0,5" />
                            <ItemsControl ItemsSource="{Binding ManualAttachmentPaths}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <Button DockPanel.Dock="Right" Content="Quitar" Click="RemoveAttachment_Click"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                                    Style="{StaticResource CompactButtonStyle}" Margin="8,0,0,0" />
                                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="La firma global es independiente y nunca aparece en esta lista."
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>

        <Border Grid.Row="5" Style="{StaticResource CardStyle}" Padding="14" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel IsEnabled="{Binding IsUiEnabled}" VerticalAlignment="Center">
                    <Button Content="Nuevo envío" Click="NewBatch_Click" />
                    <Button Content="Guardar" Click="Save_Click" />
                    <Button Content="Ver envíos recientes" Click="RecentSends_Click" />
                </WrapPanel>
                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding OperationText}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                    <ProgressBar Minimum="0" Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue}" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" IsEnabled="{Binding IsUiEnabled}">
                    <Button Content="Enviar seleccionados" Click="SendSelected_Click" />
                    <Button Content="Enviar todos" Click="SendAll_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0" MinWidth="130" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
