<Window x:Class="ECS.CommissionsMailer.Views.WorksheetNameEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pestaña asociada" Width="500" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindowStyle}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Nombre exacto de la pestaña" Style="{StaticResource PageTitleTextStyle}" />
        <TextBlock Grid.Row="1"
                   Text="La comparación ignora mayúsculas y espacios externos, pero no usa coincidencias parciales."
                   TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,16" />
        <TextBox x:Name="WorksheetNameTextBox" Grid.Row="2"
                 MinHeight="34" MaxLength="31" VerticalAlignment="Top" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" IsCancel="True" />
            <Button Content="Guardar" Click="Save_Click" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
