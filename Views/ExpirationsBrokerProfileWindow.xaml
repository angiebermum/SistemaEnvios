<Window x:Class="ECS.CommissionsMailer.Views.ExpirationsBrokerProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar corredor — Vencimientos"
        Width="860" Height="760" MinWidth="760" MinHeight="680"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing"
        Style="{StaticResource DialogWindowStyle}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Configurar corredor — Vencimientos" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="El nombre y correo principal son compartidos con Comisiones."
                       Style="{StaticResource PageSubtitleTextStyle}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,18,0,0" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Corredor" Style="{StaticResource CaptionTextStyle}" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Text="Correo principal" Style="{StaticResource CaptionTextStyle}"
                           Margin="0,10,0,0" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PrimaryEmailsText}"
                           TextWrapping="Wrap" Margin="0,10,0,0" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource WarningPanelStyle}" Margin="0,12,0,0"
                Visibility="{Binding MissingPrimaryEmailVisibility}">
            <TextBlock Text="Este corredor no tiene correo principal registrado." TextWrapping="Wrap" />
        </Border>

        <ToggleButton Grid.Row="3" Content="Activo en Vencimientos"
                      IsChecked="{Binding IsActive, Mode=TwoWay}"
                      IsEnabled="{Binding CanEditConfiguration}"
                      Style="{StaticResource SwitchToggleButtonStyle}"
                      HorizontalAlignment="Left" Margin="0,16,0,12" />

        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,14"
                Visibility="{Binding PreviousMonthFormatVisibility}">
            <StackPanel>
                <TextBlock Text="Formato para este proceso"
                           Style="{StaticResource SectionTitleTextStyle}" />
                <TextBlock Text="Estándar" FontWeight="SemiBold" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,14"
                Visibility="{Binding NextMonthFormatVisibility}">
            <StackPanel>
                <TextBlock Text="Formato para vencimientos del mes siguiente"
                           Style="{StaticResource SectionTitleTextStyle}" />
                <ComboBox ItemsSource="{Binding NextMonthGenerationModeOptions}"
                          SelectedItem="{Binding SelectedNextMonthGenerationModeOption, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          IsEnabled="{Binding CanEditConfiguration}"
                          Width="340" HorizontalAlignment="Left" Margin="0,8,0,0" />
                <TextBlock Text="El formato especial se utiliza únicamente para el corredor que requiere los dos reportes de mes siguiente."
                           Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding AssistantsSectionTitle}" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock Text="{Binding AssistantsSectionDescription}"
                               Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Agregar" Click="AddAssistant_Click"
                            IsEnabled="{Binding CanEditConfiguration}"
                            Style="{StaticResource CompactButtonStyle}" />
                    <Button Content="Editar" Click="EditAssistant_Click" IsEnabled="{Binding CanEditAssistant}"
                            Style="{StaticResource CompactButtonStyle}" />
                    <Button Content="Activar / Desactivar" Click="ToggleAssistant_Click"
                            IsEnabled="{Binding CanToggleAssistant}"
                            Style="{StaticResource CompactButtonStyle}" />
                    <Button Content="Eliminar" Click="DeleteAssistant_Click"
                            IsEnabled="{Binding CanDeleteAssistant}"
                            Style="{StaticResource CompactButtonStyle}" Margin="0" />
                </StackPanel>
            </Grid>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Assistants}"
                      SelectedItem="{Binding SelectedAssistant, Mode=TwoWay}"
                      IsReadOnly="True" AutoGenerateColumns="False" Margin="0,10,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="220" />
                    <DataGridTextColumn Header="Correo" Binding="{Binding Email}" Width="430" />
                    <DataGridCheckBoxColumn Header="Activo" Binding="{Binding IsActive}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid Grid.Row="6" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ChangesText}" Style="{StaticResource CaptionTextStyle}"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancelar" Click="Cancel_Click" IsEnabled="{Binding CanEditConfiguration}"
                        Style="{StaticResource CompactButtonStyle}" />
                <Button Content="Guardar cambios" Click="Save_Click" IsDefault="True"
                        IsEnabled="{Binding CanSave}" Style="{StaticResource PrimaryButtonStyle}" Margin="0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
