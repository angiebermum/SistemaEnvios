<Window x:Class="ECS.CommissionsMailer.Views.ModuleSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seleccionar módulo — Essential Corredora de Seguros"
        Icon="pack://application:,,,/Images/icon.ico"
        Width="720" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource DialogWindowStyle}">
    <Border Style="{StaticResource CardStyle}" Margin="16" Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Essential Corredora de Seguros" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Seleccione el módulo que desea utilizar."
                           Style="{StaticResource PageSubtitleTextStyle}" Margin="0,5,0,0" />
                <TextBlock Text="{Binding SignedInUserText}" Style="{StaticResource CaptionTextStyle}"
                           Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,26,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Comisiones" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Grid.Row="1" Text="Preparación y envío de comisiones."
                                   Style="{StaticResource MutedTextStyle}" Margin="0,8,0,20"
                                   TextWrapping="Wrap" />
                        <Button Grid.Row="2" Content="Comisiones" Click="Commissions_Click"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="0"
                                HorizontalContentAlignment="Center" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Vencimientos" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Grid.Row="1" Text="Preparación y envío de vencimientos."
                                   Style="{StaticResource MutedTextStyle}" Margin="0,8,0,20"
                                   TextWrapping="Wrap" />
                        <Button Grid.Row="2" Content="Vencimientos" Click="Expirations_Click"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="0"
                                HorizontalContentAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

            <Button Grid.Row="2" Content="Cerrar sesión" Click="Logout_Click"
                    Style="{StaticResource CompactButtonStyle}" HorizontalAlignment="Left"
                    Margin="0,22,0,0" />
        </Grid>
    </Border>
</Window>
