<Window x:Class="ECS.CommissionsMailer.Views.ExpirationsPremiumColumnSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seleccionar Prima y Moneda"
        Width="620" Height="390" MinWidth="560" MinHeight="350"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindowStyle}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Seleccionar columnas de primas" Style="{StaticResource PageTitleTextStyle}" />
        <TextBlock Grid.Row="1" Text="{Binding WorkbookLocationText}" TextWrapping="Wrap"
                   Style="{StaticResource PageSubtitleTextStyle}" Margin="0,5,0,18" />

        <StackPanel Grid.Row="2">
            <TextBlock Text="Prima" Style="{StaticResource CaptionTextStyle}" />
            <ComboBox ItemsSource="{Binding Columns}" SelectedItem="{Binding SelectedPremiumColumn, Mode=TwoWay}"
                      DisplayMemberPath="DisplayText" Margin="0,5,0,14" />
        </StackPanel>
        <StackPanel Grid.Row="3">
            <TextBlock Text="Moneda" Style="{StaticResource CaptionTextStyle}" />
            <ComboBox ItemsSource="{Binding Columns}" SelectedItem="{Binding SelectedCurrencyColumn, Mode=TwoWay}"
                      DisplayMemberPath="DisplayText" Margin="0,5,0,14" />
        </StackPanel>
        <TextBlock Grid.Row="4" Text="Prima y Moneda deben ser columnas distintas. La selección se conserva solo durante esta sesión y para el archivo actual."
                   TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" Click="Cancel_Click" Style="{StaticResource CompactButtonStyle}" />
            <Button Content="Usar columnas" Click="Accept_Click" IsDefault="True"
                    IsEnabled="{Binding CanAccept}" Style="{StaticResource PrimaryButtonStyle}" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
