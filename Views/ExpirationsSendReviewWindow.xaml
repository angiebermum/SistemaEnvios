<Window x:Class="ECS.CommissionsMailer.Views.ExpirationsSendReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revisar y enviar — Vencimientos"
        Width="980" Height="780" MinWidth="860" MinHeight="680"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded"
        Style="{StaticResource DialogWindowStyle}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Revisar envío de Vencimientos" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="{Binding ProcessText}" Style="{StaticResource PageSubtitleTextStyle}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,16,0,0" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Asunto" Style="{StaticResource CaptionTextStyle}" />
                <TextBlock Grid.Column="1" Text="{Binding Subject}" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Text="Mensaje" Style="{StaticResource CaptionTextStyle}" Margin="0,10,0,0" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,10,0,0" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource WarningPanelStyle}" Margin="0,10,0,0"
                Visibility="{Binding WarningsVisibility}">
            <TextBlock Text="{Binding WarningsText}" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <ItemsControl ItemsSource="{Binding ReviewItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding BrokerName}" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="{Binding ToText, StringFormat=Para: {0}}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                <TextBlock Text="{Binding CcText, StringFormat=CC: {0}}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                <TextBlock Text="Archivos" Style="{StaticResource CaptionTextStyle}" Margin="0,7,0,2" />
                                <ItemsControl ItemsSource="{Binding AttachmentNames}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat=• {0}}" Margin="8,1,0,0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" FontWeight="SemiBold"
                                           Margin="0,8,0,0" Visibility="{Binding ResultVisibility}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="4" Style="{StaticResource InfoPanelStyle}" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Cuenta Outlook:" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableAccounts}"
                          SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                          IsEnabled="{Binding CanSelectAccount}" />
                <TextBlock Grid.Column="2" Text="{Binding OutlookStatusText}" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
        </Border>

        <Grid Grid.Row="5" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding ProgressText}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" Margin="0,3,0,0"
                           Visibility="{Binding ResultsVisibility}" />
                <TextBlock Text="{Binding HistoryWarningText}" TextWrapping="Wrap" Foreground="#9A3412"
                           FontWeight="SemiBold" Margin="0,4,12,0"
                           Visibility="{Binding HistoryWarningVisibility}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Cancelar" Click="Cancel_Click" IsEnabled="{Binding CanCancel}"
                        Style="{StaticResource CompactButtonStyle}" />
                <Button Content="Continuar con Outlook" Click="Continue_Click" IsDefault="True"
                        IsEnabled="{Binding CanContinue}" Style="{StaticResource PrimaryButtonStyle}" Margin="0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
