<Window x:Class="ECS.CommissionsMailer.Views.AppDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500" MinWidth="420" MaxWidth="640" SizeToContent="Height"
        MaxHeight="620" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindowStyle}">
    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="AccentBar" CornerRadius="10,0,0,10" />
            <Grid Grid.Column="1" Margin="24,22,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="IconBorder" Width="42" Height="42" CornerRadius="21" Margin="0,0,14,0">
                        <TextBlock x:Name="IconText" FontFamily="Segoe Fluent Icons" FontSize="21"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="TitleTextBlock" Grid.Column="1" Style="{StaticResource PageTitleTextStyle}"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>

                <ScrollViewer Grid.Row="1" MaxHeight="360" VerticalScrollBarVisibility="Auto" Margin="56,16,0,0">
                    <TextBlock x:Name="MessageTextBlock" TextWrapping="Wrap" LineHeight="21"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button x:Name="TertiaryButton" Click="TertiaryButton_Click" Visibility="Collapsed" />
                    <Button x:Name="SecondaryButton" Click="SecondaryButton_Click" Visibility="Collapsed" />
                    <Button x:Name="PrimaryButton" Click="PrimaryButton_Click"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0" MinWidth="96" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
