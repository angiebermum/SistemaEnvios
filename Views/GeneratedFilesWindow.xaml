<Window x:Class="ECS.CommissionsMailer.Views.GeneratedFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ECS.CommissionsMailer.Views"
        Title="Archivos asociados" Width="1120" Height="610" MinWidth="900" MinHeight="460"
        WindowStartupLocation="CenterOwner" Style="{StaticResource DialogWindowStyle}">
    <Window.Resources>
        <views:GeneratedFileNameConverter x:Key="GeneratedFileNameConverter" />
        <views:GeneratedFileAvailabilityConverter x:Key="GeneratedFileAvailabilityConverter" />
        <views:AssociatedFileOriginConverter x:Key="AssociatedFileOriginConverter" />
        <views:AssociatedFileModifiedConverter x:Key="AssociatedFileModifiedConverter" />
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding TitleText}" Style="{StaticResource PageTitleTextStyle}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding FileCountText}" Style="{StaticResource MutedTextStyle}"
                       Margin="0,5,0,0" />
        </StackPanel>

        <DataGrid x:Name="GeneratedFilesGrid" Grid.Row="1" Margin="0,18,0,0"
                  ItemsSource="{Binding Files}" IsReadOnly="True"
                  RowDetailsVisibilityMode="Collapsed"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Archivo" Width="3*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,5">
                                <TextBlock Text="{Binding Converter={StaticResource GeneratedFileNameConverter}}"
                                           FontWeight="SemiBold" TextWrapping="Wrap"
                                           ToolTip="{Binding}" />
                                <TextBlock Text="{Binding}" Style="{StaticResource CaptionTextStyle}"
                                           TextWrapping="Wrap" ToolTip="{Binding}" Margin="0,3,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Origen" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock FontWeight="SemiBold">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource AssociatedFileOriginConverter}">
                                        <Binding />
                                        <Binding Path="DataContext.Broker.GeneratedAttachmentPaths"
                                                 RelativeSource="{RelativeSource AncestorType=Window}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Modificado" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource AssociatedFileModifiedConverter}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Estado" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource GeneratedFileAvailabilityConverter}}"
                                       FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Converter={StaticResource GeneratedFileAvailabilityConverter}}"
                                                         Value="Disponible">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Acciones" Width="330">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Ver" Click="ViewFile_Click" CommandParameter="{Binding}"
                                        Style="{StaticResource CompactButtonStyle}" Margin="0" />
                                <Button Content="Editar" Click="EditFile_Click" CommandParameter="{Binding}"
                                        Style="{StaticResource CompactButtonStyle}" />
                                <Button Content="Eliminar de la lista" Click="UnlinkFile_Click"
                                        CommandParameter="{Binding}" Style="{StaticResource CompactButtonStyle}"
                                        Margin="0" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Agregar archivo manual" Click="AddManualFile_Click" MinWidth="170" />
            <Button Content="Cerrar" IsCancel="True" Margin="0" MinWidth="90" />
        </StackPanel>
    </Grid>
</Window>
