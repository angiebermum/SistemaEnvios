<Window x:Class="ECS.CommissionsMailer.Views.UserAdministrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Administración de accesos — ECS Comisiones"
        Icon="pack://application:,,,/Images/icon.ico"
        Width="900" Height="600" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterOwner" Style="{StaticResource DialogWindowStyle}"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Administración de accesos" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Los usuarios Firebase Auth se crean en Firebase Console. Aquí se administran permisos funcionales."
                           Style="{StaticResource PageSubtitleTextStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <TextBox x:Name="SearchTextBox" Grid.Column="1" Margin="12,0,0,0"
                     VerticalAlignment="Center" TextChanged="SearchTextBox_TextChanged"
                     ToolTip="Buscar por nombre o correo" />
            <Button x:Name="CreateButton" Grid.Column="2" Content="Registrar perfil" Click="Create_Click"
                    Margin="10,0,0,0" VerticalAlignment="Center" />
        </Grid>

        <DataGrid x:Name="UsersGrid" Grid.Row="1" Margin="0,18,0,14" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single" SelectionChanged="UsersGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre" Binding="{Binding User.DisplayName}" Width="*" />
                <DataGridTextColumn Header="Correo" Binding="{Binding User.Email}" Width="2*" />
                <DataGridTextColumn Header="Rol" Binding="{Binding User.Role}" Width="110" />
                <DataGridCheckBoxColumn Header="Activo" Binding="{Binding User.IsActive}" Width="80" />
                <DataGridCheckBoxColumn Header="Comisiones" Binding="{Binding User.CanUseCommissions}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="ActiveCheckBox" Content="Perfil activo" IsEnabled="False" />
                <CheckBox x:Name="CommissionsCheckBox" Content="Puede usar Comisiones" Margin="18,4,0,4" IsEnabled="False" />
                <TextBlock Text="Rol" Margin="22,0,8,0" VerticalAlignment="Center" />
                <ComboBox x:Name="RoleComboBox" Width="120" IsEnabled="False" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" Margin="0,0,14,0"
                           Style="{StaticResource CaptionTextStyle}" />
                <Button x:Name="ReloadButton" Content="Recargar" Click="Reload_Click" />
                <Button x:Name="SaveButton" Content="Guardar permisos" Click="Save_Click"
                        Style="{StaticResource PrimaryButtonStyle}" Margin="0" IsEnabled="False" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
