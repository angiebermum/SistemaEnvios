<Window x:Class="ECS.CommissionsMailer.Views.ExpirationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ECS Envío de Correos — Vencimientos"
        Icon="pack://application:,,,/Images/icon.ico"
        Width="1240" Height="820" MinWidth="980" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindowStyle}">
    <Grid Margin="20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="16,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="108" Height="58" Background="{StaticResource SurfaceBrush}"
                        CornerRadius="7" Padding="3" Margin="0,0,14,0" ClipToBounds="True">
                    <Image Stretch="Uniform" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Source>
                            <CroppedBitmap SourceRect="110 430 1060 420">
                                <CroppedBitmap.Source>
                                    <BitmapImage UriSource="pack://application:,,,/Images/icon.jpeg" CacheOption="OnLoad" />
                                </CroppedBitmap.Source>
                            </CroppedBitmap>
                        </Image.Source>
                    </Image>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="ECS Envío de Correos" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="Módulo de Vencimientos" Style="{StaticResource PageSubtitleTextStyle}"
                               Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" MaxWidth="420">
                    <TextBlock Text="{Binding SignedInUserText}" FontWeight="SemiBold"
                               TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Button Content="Administrar accesos" Click="ManageAccess_Click"
                                Visibility="{Binding AdminAccessVisibility}"
                                Style="{StaticResource CompactButtonStyle}" Padding="5,1" MinHeight="22" />
                        <Button Content="Cerrar sesión" Click="Logout_Click"
                                Style="{StaticResource CompactButtonStyle}" Padding="5,1"
                                MinHeight="22" Margin="0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Preparación de vencimientos" Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock Text="Seleccione el proceso y el reporte general que desea analizar."
                                           Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Configurar corredores"
                                    Click="ConfigureBrokers_Click"
                                    IsEnabled="{Binding CanConfigureBrokers}"
                                    Style="{StaticResource CompactButtonStyle}" Margin="12,0,0,0"
                                    VerticalAlignment="Center" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="420" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Proceso" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                            <ComboBox x:Name="ProcessComboBox" Grid.Column="1"
                                      ItemsSource="{Binding ProcessOptions}"
                                      SelectedItem="{Binding SelectedProcessOption, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      IsEnabled="{Binding CanSelectFile}"
                                      SelectionChanged="ProcessComboBox_SelectionChanged" />
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Archivo" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding SourcePath, Mode=OneWay}" IsReadOnly="True"
                                     ToolTip="{Binding SourcePath}" VerticalContentAlignment="Center" />
                            <Button Grid.Column="2" Content="Seleccionar" Click="SelectFile_Click"
                                    IsEnabled="{Binding CanSelectFile}" Style="{StaticResource CompactButtonStyle}"
                                    Margin="10,0,0,0" />
                        </Grid>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="150,14,0,0">
                            <Button Content="Analizar archivo" Click="Analyze_Click"
                                    IsEnabled="{Binding CanAnalyze}" Style="{StaticResource PrimaryButtonStyle}" />
                            <TextBlock Text="{Binding OperationStatusText}" Style="{StaticResource CaptionTextStyle}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       Visibility="{Binding BusyVisibility}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12"
                        Visibility="{Binding ResultVisibility}">
                    <StackPanel>
                        <TextBlock Text="Resumen del análisis" Style="{StaticResource SectionTitleTextStyle}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Total de registros" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="{Binding TotalRows}" FontSize="22" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Registros resueltos" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="{Binding ResolvedRows}" FontSize="22" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Pendientes" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="{Binding PendingRows}" FontSize="22" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Corredores destino" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="{Binding DestinationCount}" FontSize="22" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource InfoPanelStyle}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusDetailText}" Style="{StaticResource MutedTextStyle}"
                                           TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12"
                        Visibility="{Binding AnalysisVisibility}">
                    <StackPanel>
                        <TextBlock Text="Distribución por corredor" Style="{StaticResource SectionTitleTextStyle}" />
                        <DataGrid ItemsSource="{Binding PreviewItems}" IsReadOnly="True" AutoGenerateColumns="False"
                                  Height="230" Margin="0,12,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Corredor" Binding="{Binding BrokerName}" Width="210" />
                                <DataGridTextColumn Header="Correo principal" Binding="{Binding PrimaryEmail}" Width="260" />
                                <DataGridTextColumn Header="Registros" Binding="{Binding RowCount}" Width="90" />
                                <DataGridTextColumn Header="Nombres / alias / códigos detectados"
                                                    Binding="{Binding DetectedValuesText}" Width="540" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12"
                        Visibility="{Binding AnalysisVisibility}">
                    <StackPanel>
                        <TextBlock Text="Pendientes por resolver" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="{Binding ReadyText}"
                                   Style="{StaticResource MutedTextStyle}" Margin="0,12,0,0"
                                   Visibility="{Binding ReadyVisibility}" />
                        <DataGrid ItemsSource="{Binding PendingItems}"
                                  SelectedItem="{Binding SelectedPendingIssue, Mode=TwoWay}"
                                  IsReadOnly="True" AutoGenerateColumns="False"
                                  Height="230" Margin="0,12,0,0"
                                  Visibility="{Binding PendingVisibility}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fila" Binding="{Binding RowNumber}" Width="80" />
                                <DataGridTextColumn Header="Valor encontrado" Binding="{Binding RawValue}" Width="420" />
                                <DataGridTextColumn Header="Estado" Binding="{Binding StatusText}" Width="180" />
                                <DataGridTextColumn Header="Posibles corredores" Binding="{Binding CandidateBrokerNames}" Width="420" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Content="Resolver seleccionado" Click="ResolveSelected_Click"
                                IsEnabled="{Binding CanResolve}" Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Left" Margin="0,12,0,0"
                                Visibility="{Binding PendingVisibility}" />
                    </StackPanel>
                </Border>

                <Border x:Name="GenerationSection" Style="{StaticResource CardStyle}"
                        Visibility="{Binding GenerationVisibility}">
                    <StackPanel>
                        <TextBlock Text="Generación de archivos" Style="{StaticResource SectionTitleTextStyle}" />
                        <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,10,0,0"
                                Visibility="{Binding NextMonthPeriodVisibility}">
                            <StackPanel>
                                <TextBlock Text="Período del reporte" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Mes" Style="{StaticResource CaptionTextStyle}"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox Width="190" ItemsSource="{Binding MonthOptions}"
                                              SelectedItem="{Binding SelectedMonthOption, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName"
                                              SelectionChanged="NextMonthPeriod_Changed" />
                                    <TextBlock Text="Año" Style="{StaticResource CaptionTextStyle}"
                                               VerticalAlignment="Center" Margin="18,0,8,0" />
                                    <TextBox Width="90" Text="{Binding NextMonthYearText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             TextChanged="NextMonthPeriod_Changed" />
                                </StackPanel>
                                <TextBlock Text="{Binding GenerationReadinessText}" TextWrapping="Wrap"
                                           Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" />
                                <Button Content="Seleccionar columnas Prima / Moneda"
                                        Click="SelectPremiumColumns_Click"
                                        Visibility="{Binding PremiumColumnSelectionVisibility}"
                                        IsEnabled="{Binding CanSelectPremiumColumns}"
                                        Style="{StaticResource CompactButtonStyle}"
                                        HorizontalAlignment="Left" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Generar archivos" Click="GenerateFiles_Click"
                                    IsEnabled="{Binding CanGenerate}" Style="{StaticResource PrimaryButtonStyle}" />
                            <TextBlock Text="{Binding OperationStatusText}" Style="{StaticResource CaptionTextStyle}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       Visibility="{Binding BusyVisibility}" />
                        </StackPanel>
                        <Border Style="{StaticResource InfoPanelStyle}" Margin="0,12,0,0"
                                Visibility="{Binding GenerationResultVisibility}">
                            <StackPanel>
                                <TextBlock Text="Generación completada." FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,0">
                                    <Run Text="Corredores con archivos: " /><Run Text="{Binding GeneratedBrokerCount, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Margin="0,2,0,0">
                                    <Run Text="Archivos generados: " /><Run Text="{Binding GeneratedFileCount, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding GeneratedOutputDirectory}" TextWrapping="Wrap"
                                           Style="{StaticResource MutedTextStyle}" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding GenerationWarningsText}" TextWrapping="Wrap"
                                           Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" />
                                <Button Content="Abrir carpeta" Click="OpenGeneratedFolder_Click"
                                        Style="{StaticResource CompactButtonStyle}"
                                        HorizontalAlignment="Left" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
