<Window x:Class="ECS.CommissionsMailer.Views.DeductionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rebajo" Width="560" Height="430" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Style="{StaticResource DialogWindowStyle}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Rebajo configurable" Style="{StaticResource PageTitleTextStyle}" />
        <TextBlock Grid.Row="1" Text="El monto se guarda positivo y se muestra como descuento en el Excel."
                   Style="{StaticResource MutedTextStyle}" Margin="0,5,0,18" />
        <StackPanel Grid.Row="2">
            <TextBlock Text="Descripción" Style="{StaticResource FieldLabelTextStyle}" />
            <TextBox x:Name="DescriptionTextBox" />
        </StackPanel>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Monto" Style="{StaticResource FieldLabelTextStyle}" />
                <TextBox x:Name="AmountTextBox" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Moneda" Style="{StaticResource FieldLabelTextStyle}" />
                <ComboBox x:Name="CurrencyComboBox">
                    <ComboBoxItem Content="CRC — Colones" Tag="CRC" />
                    <ComboBoxItem Content="USD — Dólares" Tag="USD" />
                </ComboBox>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Text="Tipo de aplicación" Style="{StaticResource FieldLabelTextStyle}" />
            <ComboBox x:Name="ApplicationTypeComboBox">
                <ComboBoxItem Content="Monto bruto de comisión" Tag="GrossCommission" />
                <ComboBoxItem Content="Monto a pagar" Tag="PayableAmount" />
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" IsCancel="True" />
            <Button Content="Guardar rebajo" Click="Save_Click" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
