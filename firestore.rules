rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function currentAppUser() {
      return get(/databases/$(database)/documents/appUsers/$(request.auth.uid)).data;
    }

    function hasAppProfile() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/appUsers/$(request.auth.uid));
    }

    function isActive() {
      return hasAppProfile() && currentAppUser().isActive == true;
    }

    function canUseCommissions() {
      return isActive() && currentAppUser().canUseCommissions == true;
    }

    function canUseExpirations() {
      return isActive() && currentAppUser().get('canUseExpirations', false) == true;
    }

    function isAdmin() {
      return isActive() && currentAppUser().role == 'admin';
    }

    function validAppUserShape() {
      return request.resource.data.keys().hasAll([
          'uid', 'email', 'displayName', 'role', 'isActive',
          'canUseCommissions', 'canUseExpirations', 'createdAtUtc', 'updatedAtUtc'
        ]) &&
        request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'role', 'isActive',
          'canUseCommissions', 'canUseExpirations', 'createdAtUtc', 'updatedAtUtc'
        ]) &&
        request.resource.data.uid is string &&
        request.resource.data.email is string &&
        request.resource.data.displayName is string &&
        request.resource.data.role in ['admin', 'operator'] &&
        request.resource.data.isActive is bool &&
        request.resource.data.canUseCommissions is bool &&
        request.resource.data.canUseExpirations is bool &&
        request.resource.data.createdAtUtc is timestamp &&
        request.resource.data.updatedAtUtc is timestamp;
    }

    function validExpirationsBrokerProfileShape(brokerId) {
      return request.resource.data.keys().hasAll([
          'brokerId', 'isActive', 'assistants', 'createdAtUtc', 'updatedAtUtc'
        ]) &&
        request.resource.data.keys().hasOnly([
          'brokerId', 'isActive', 'assistants', 'createdAtUtc', 'updatedAtUtc',
          'nextMonthGenerationMode'
        ]) &&
        request.resource.data.brokerId is string &&
        request.resource.data.brokerId == brokerId &&
        request.resource.data.isActive is bool &&
        request.resource.data.assistants is list &&
        request.resource.data.get('nextMonthGenerationMode', 'Standard') in [
          'Standard', 'SpecialDualSorted'
        ] &&
        request.resource.data.createdAtUtc is timestamp &&
        request.resource.data.updatedAtUtc is timestamp;
    }

    function validExpirationsAssociationShape(associationId) {
      return request.resource.data.keys().hasAll([
          'id', 'brokerId', 'kind', 'value', 'normalizedValue', 'isActive',
          'createdAtUtc', 'updatedAtUtc'
        ]) &&
        request.resource.data.keys().hasOnly([
          'id', 'brokerId', 'kind', 'value', 'normalizedValue', 'isActive',
          'createdAtUtc', 'updatedAtUtc'
        ]) &&
        request.resource.data.id is string &&
        request.resource.data.id == associationId &&
        request.resource.data.brokerId is string &&
        request.resource.data.kind in ['Name', 'Alias', 'Code'] &&
        request.resource.data.value is string &&
        request.resource.data.normalizedValue is string &&
        request.resource.data.isActive is bool &&
        request.resource.data.createdAtUtc is timestamp &&
        request.resource.data.updatedAtUtc is timestamp;
    }

    function validExpirationsSettingsShape() {
      return request.resource.data.keys().hasAll([
          'defaultSubject', 'defaultMessage', 'commonCcAddresses', 'updatedAtUtc'
        ]) &&
        request.resource.data.keys().hasOnly([
          'defaultSubject', 'defaultMessage', 'commonCcAddresses', 'updatedAtUtc'
        ]) &&
        request.resource.data.defaultSubject is string &&
        request.resource.data.defaultMessage is string &&
        request.resource.data.commonCcAddresses is list &&
        request.resource.data.updatedAtUtc is timestamp;
    }

    // Technical metadata is administrative only. Server/Admin SDK access based on
    // IAM bypasses these client rules and remains available to bootstrap/migration.
    match /system/{document=**} {
      allow read, write: if false;
    }

    match /appUsers/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin() && validAppUserShape() &&
        request.resource.data.uid == uid;
      allow delete: if false;
      allow update: if isAdmin() && validAppUserShape() &&
        request.resource.data.uid == uid &&
        request.resource.data.createdAtUtc == resource.data.createdAtUtc;
    }

    match /settings/{document} {
      allow read, write: if canUseCommissions();
    }

    match /brokers/{document} {
      allow read: if canUseCommissions() || canUseExpirations();
      allow create, update, delete: if canUseCommissions();
    }

    match /modules/vencimientos/brokerProfiles/{brokerId} {
      allow read: if canUseExpirations();
      allow create, update: if canUseExpirations() &&
        validExpirationsBrokerProfileShape(brokerId) &&
        exists(/databases/$(database)/documents/brokers/$(brokerId));
      allow delete: if false;
    }

    match /modules/vencimientos/associations/{associationId} {
      allow read: if canUseExpirations();
      allow create, update: if canUseExpirations() &&
        validExpirationsAssociationShape(associationId) &&
        exists(/databases/$(database)/documents/brokers/$(request.resource.data.brokerId));
      allow delete: if false;
    }

    match /modules/vencimientos/settings/{processId} {
      allow read: if canUseExpirations() && processId in ['previousMonth', 'nextMonth'];
      allow create, update: if canUseExpirations() &&
        processId in ['previousMonth', 'nextMonth'] &&
        validExpirationsSettingsShape();
      allow delete: if false;
    }

    match /sessions/{sessionId} {
      allow read, write: if canUseCommissions();
      match /brokerItems/{brokerId} {
        allow read, write: if canUseCommissions();
      }
    }

    match /recentSends/{document} {
      allow read, write: if canUseCommissions();
    }

    match /paymentGenerations/{generationId} {
      allow read, write: if canUseCommissions();
      match /files/{fileId} {
        allow read, write: if canUseCommissions();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
