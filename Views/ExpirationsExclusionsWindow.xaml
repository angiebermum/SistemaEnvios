<Window x:Class="ECS.CommissionsMailer.Views.ExpirationsExclusionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exclusiones de vencimientos"
        Width="820" Height="600" MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded"
        Style="{StaticResource DialogWindowStyle}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Exclusiones de vencimientos" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="Administre los valores globales que no deben generar archivos ni distribución."
                       Style="{StaticResource PageSubtitleTextStyle}" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,18,0,12">
            <TextBlock Text="Buscar por valor" Style="{StaticResource CaptionTextStyle}" />
            <TextBox Width="440" HorizontalAlignment="Left"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" />
        </StackPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding VisibleItems}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  IsReadOnly="True" AutoGenerateColumns="False" IsEnabled="{Binding IsUiEnabled}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Valor" Binding="{Binding Exclusion.Value}" Width="*" />
                <DataGridTextColumn Header="Estado" Binding="{Binding StatusText}" Width="140" />
                <DataGridTextColumn Header="Actualizado" Binding="{Binding Exclusion.UpdatedAtUtc, StringFormat={}{0:g}}" Width="190" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Desactivar" Click="Deactivate_Click"
                        IsEnabled="{Binding CanDeactivate}" Style="{StaticResource CompactButtonStyle}" />
                <Button Content="Reactivar" Click="Reactivate_Click"
                        IsEnabled="{Binding CanReactivate}" Style="{StaticResource CompactButtonStyle}" />
                <TextBlock Text="{Binding BusyText}" Style="{StaticResource CaptionTextStyle}"
                           Visibility="{Binding BusyVisibility}" VerticalAlignment="Center" />
            </StackPanel>
            <Button Content="Cerrar" IsCancel="True" HorizontalAlignment="Right"
                    Style="{StaticResource CompactButtonStyle}" Margin="0" />
        </Grid>
    </Grid>
</Window>
