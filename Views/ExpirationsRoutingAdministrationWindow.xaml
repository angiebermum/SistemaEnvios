<Window x:Class="ECS.CommissionsMailer.Views.ExpirationsRoutingAdministrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Identificadores conocidos — Vencimientos"
        Width="1120" Height="760" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded"
        Style="{StaticResource DialogWindowStyle}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Identificadores conocidos — Vencimientos"
                       Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="Los valores identificados de forma segura no requieren ninguna acción. Intervenga sólo para corregir o crear una asociación permanente."
                       Style="{StaticResource PageSubtitleTextStyle}" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,12" IsEnabled="{Binding IsUiEnabled}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Buscar por nombre, código, alias, corredor, correo u origen"
                           Style="{StaticResource CaptionTextStyle}" />
                <TextBox Text="{Binding AssociationSearchText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Corredor" Style="{StaticResource CaptionTextStyle}" />
                <ComboBox ItemsSource="{Binding BrokerFilters}"
                          SelectedItem="{Binding SelectedBrokerFilter, Mode=TwoWay}"
                          DisplayMemberPath="DisplayText" Margin="0,5,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14"
                Visibility="{Binding BrokerIdentityVisibility}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Nombre principal" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{Binding SelectedBrokerName}" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                    <TextBlock Text="Correo principal" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{Binding SelectedBrokerEmail}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="18,0,0,0">
                    <TextBlock Text="Estado" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{Binding SelectedBrokerStatus}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,12,0,8">
            <TextBlock Text="Identificadores conocidos" FontWeight="SemiBold" />
            <TextBlock Text="Este corredor sólo tiene su identidad maestra."
                       Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"
                       Visibility="{Binding NoAssociationsVisibility}" />
            <TextBlock Text="Nombre: nombre alternativo utilizado para identificar al corredor.  ·  Alias: otra forma en que puede aparecer el corredor en el Excel.  ·  Código: código único utilizado para identificar al corredor."
                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <DataGrid Grid.Row="4" ItemsSource="{Binding VisibleKnownIdentifiers}"
                  SelectedItem="{Binding SelectedKnownIdentifier, Mode=TwoWay}"
                  IsReadOnly="True" AutoGenerateColumns="False" IsEnabled="{Binding IsUiEnabled}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tipo" Binding="{Binding KindText}" Width="110" />
                <DataGridTemplateColumn Header="Identificador" Width="*" MinWidth="340">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,3">
                                <TextBlock Text="{Binding Value}" />
                                <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DetailText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Estado" Binding="{Binding StatusText}" Width="110" />
                <DataGridTextColumn Header="Actualizado" Binding="{Binding UpdatedAtUtc, StringFormat={}{0:g}}" Width="145" />
            </DataGrid.Columns>
        </DataGrid>

        <WrapPanel Grid.Row="5" Margin="0,14,0,0" IsEnabled="{Binding IsUiEnabled}">
            <Button Content="Agregar asociación" Click="AddAssociation_Click"
                    IsEnabled="{Binding CanAddAssociation}" Style="{StaticResource PrimaryButtonStyle}" />
            <Button Content="Editar" Click="EditAssociation_Click"
                    IsEnabled="{Binding CanEditAssociation}" Visibility="{Binding AssociationActionsVisibility}"
                    Style="{StaticResource CompactButtonStyle}" />
            <Button Content="Inactivar" Click="DeactivateAssociation_Click"
                    IsEnabled="{Binding CanDeactivateAssociation}" Visibility="{Binding DeactivateActionVisibility}"
                    Style="{StaticResource CompactButtonStyle}" />
            <Button Content="Reactivar" Click="ReactivateAssociation_Click"
                    IsEnabled="{Binding CanReactivateAssociation}" Visibility="{Binding ReactivateActionVisibility}"
                    Style="{StaticResource CompactButtonStyle}" />
            <Button Content="Eliminar" Click="DeleteAssociation_Click"
                    IsEnabled="{Binding CanDeleteAssociation}" Visibility="{Binding AssociationActionsVisibility}"
                    Style="{StaticResource CompactButtonStyle}" />
            <Button Content="Usar como asociación" Click="ConfirmObserved_Click"
                    IsEnabled="{Binding CanConfirmObserved}" Visibility="{Binding ObservedActionsVisibility}"
                    Style="{StaticResource CompactButtonStyle}" />
            <Button Content="Ignorar" Click="IgnoreObserved_Click"
                    IsEnabled="{Binding CanIgnoreObserved}" Visibility="{Binding ObservedActionsVisibility}"
                    Style="{StaticResource CompactButtonStyle}" />
            <TextBlock Text="Reasignar a" Style="{StaticResource CaptionTextStyle}"
                       VerticalAlignment="Center" Margin="14,0,8,0"
                       Visibility="{Binding ReassignActionsVisibility}" />
            <ComboBox Width="270" ItemsSource="{Binding DestinationBrokers}"
                      SelectedItem="{Binding SelectedDestinationBroker, Mode=TwoWay}"
                      DisplayMemberPath="DisplayText" Visibility="{Binding ReassignActionsVisibility}" />
            <Button Content="{Binding ReassignButtonText}" Click="ReassignAssociation_Click"
                    IsEnabled="{Binding CanReassign}" Visibility="{Binding ReassignActionsVisibility}"
                    Style="{StaticResource CompactButtonStyle}" />
        </WrapPanel>

        <Grid Grid.Row="6" Margin="0,14,0,0">
            <TextBlock Text="{Binding BusyText}" Style="{StaticResource CaptionTextStyle}"
                       Visibility="{Binding BusyVisibility}" VerticalAlignment="Center" />
            <Button Content="Cerrar" IsCancel="True" HorizontalAlignment="Right"
                    Style="{StaticResource CompactButtonStyle}" Margin="0" />
        </Grid>
    </Grid>
</Window>
