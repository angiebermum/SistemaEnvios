<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>ECS Envío de Correos</AssemblyName>
    <RootNamespace>ECS.CommissionsMailer</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <PublishSingleFile>false</PublishSingleFile>
    <ApplicationIcon>Images\icon.ico</ApplicationIcon>
    <Title>ECS Envío de Correos</Title>
    <AssemblyTitle>ECS Envío de Correos</AssemblyTitle>
    <Product>ECS Envío de Correos</Product>
    <Description>Preparación y envío de comisiones mediante Outlook Classic</Description>
    <Authors>Angie Bermúdez</Authors>
    <Company>Angie Bermúdez</Company>
    <Copyright>© 2026 Angie Bermúdez</Copyright>
    <Version>1.0.8</Version>
    <AssemblyVersion>1.0.8.0</AssemblyVersion>
    <FileVersion>1.0.8.0</FileVersion>
    <InformationalVersion>1.0.8</InformationalVersion>
    <NeutralLanguage>es-CR</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.Office.Interop.Outlook" Version="15.0.4797.1004"
                      GeneratePathProperty="true" ExcludeAssets="compile;runtime" PrivateAssets="all" />
    <Reference Include="Microsoft.Office.Interop.Outlook">
      <HintPath>$(PkgMicrosoft_Office_Interop_Outlook)\lib\netstandard2.0\Microsoft.Office.Interop.Outlook.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Diagnostics\**\*.cs" />
    <Compile Remove="Tests\**\*.cs" />
    <AssemblyMetadata Include="BuildConfiguration" Value="$(Configuration)" />
    <AssemblyMetadata Include="RuntimeIdentifier" Value="$(RuntimeIdentifier)" />
    <AssemblyMetadata Include="SelfContained" Value="$(SelfContained)" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Images\icon.jpeg" />
    <Resource Include="Images\icon.ico" Condition="Exists('Images\icon.ico')" />
    <Content Include="Data\correos-iniciales.v3.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Data\RebateTemplates\*.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Data\firma-inicial.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
