<Window x:Class="ECS.CommissionsMailer.Views.BrokerEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Corredor" Width="780" Height="720" MinWidth="700" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindowStyle}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Datos del corredor" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="Los nombres pueden repetirse; el correo identifica cada registro de forma independiente."
                       Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Nombre del corredor" Style="{StaticResource FieldLabelTextStyle}" />
                <TextBox x:Name="NameTextBox" TabIndex="0" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Direcciones principales (Para)" Style="{StaticResource FieldLabelTextStyle}" />
                <TextBox x:Name="AddressesTextBox" Height="78" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" TabIndex="1" />
                <TextBlock Text="Separe varias direcciones con punto y coma, coma o salto de línea."
                           Style="{StaticResource CaptionTextStyle}" Margin="2,4,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,16,0,0" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="ActiveCheckBox" Content="Corredor activo" IsChecked="True" TabIndex="2"
                              Style="{StaticResource SwitchToggleButtonStyle}" />
                <CheckBox x:Name="ReviewCheckBox" Grid.Column="2" Content="Requiere revisión" TabIndex="3" />
                <StackPanel Grid.Column="3" Margin="18,0,0,0">
                    <TextBlock Text="Nota de revisión" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox x:Name="ReviewNoteTextBox" TextWrapping="Wrap" AcceptsReturn="True" Height="58"
                             IsEnabled="{Binding IsChecked, ElementName=ReviewCheckBox}" TabIndex="4" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,18,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Asistentes asociados" Style="{StaticResource SectionTitleTextStyle}" />
                <TextBlock Text="Los asistentes activos se agregan al mismo campo Para del correo del corredor."
                           Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Agregar" Click="AddAssistant_Click" Style="{StaticResource CompactButtonStyle}" />
                <Button Content="Editar" Click="EditAssistant_Click" Style="{StaticResource CompactButtonStyle}" />
                <ToggleButton Content="Activo" Click="ToggleAssistant_Click"
                              IsChecked="{Binding SelectedItem.IsActive, ElementName=AssistantsGrid, Mode=OneWay}"
                              Style="{StaticResource SwitchToggleButtonStyle}" Margin="0,0,12,0" />
                <Button Content="Quitar" Click="RemoveAssistant_Click" Style="{StaticResource DangerButtonStyle}" Margin="0" />
            </StackPanel>
        </Grid>

        <DataGrid x:Name="AssistantsGrid" Grid.Row="4" ItemsSource="{Binding Assistants, RelativeSource={RelativeSource AncestorType=Window}}"
                  SelectedItem="{Binding SelectedAssistant, RelativeSource={RelativeSource AncestorType=Window}}"
                  RowHeight="40" IsReadOnly="True" TabIndex="5">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Activo" Binding="{Binding IsActive}" Width="70" />
                <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="Correo" Binding="{Binding Email}" Width="3*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" IsCancel="True" TabIndex="7" />
            <Button Content="Guardar corredor" Click="Save_Click" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" Margin="0" TabIndex="6" />
        </StackPanel>
    </Grid>
</Window>
