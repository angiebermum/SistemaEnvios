<Window x:Class="ECS.CommissionsMailer.Views.ExpirationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ECS Envío de Correos — Vencimientos"
        Icon="pack://application:,,,/Images/icon.ico"
        Width="1360" Height="900" MinWidth="1100" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindowStyle}"
        Loaded="Window_Loaded">
    <Grid Margin="20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="16,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="108" Height="58" Background="White" CornerRadius="7"
                        Padding="3" Margin="0,0,14,0" ClipToBounds="True">
                    <Image Stretch="Uniform" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Source>
                            <CroppedBitmap SourceRect="110 430 1060 420">
                                <CroppedBitmap.Source>
                                    <BitmapImage UriSource="pack://application:,,,/Images/icon.jpeg" CacheOption="OnLoad" />
                                </CroppedBitmap.Source>
                            </CroppedBitmap>
                        </Image.Source>
                    </Image>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="ECS Envío de Correos" Style="{StaticResource PageTitleTextStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="Preparación y envío de vencimientos" Style="{StaticResource PageSubtitleTextStyle}" />
                        <TextBlock Text="{Binding ApplicationVersionText}" Style="{StaticResource CaptionTextStyle}"
                                   Margin="12,1,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" MaxWidth="520">
                    <TextBlock Text="{Binding SignedInUserText}" FontWeight="SemiBold"
                               TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,0,0">
                        <Button Content="Administrar accesos" Click="ManageAccess_Click"
                                Visibility="{Binding AdminAccessVisibility}"
                                Style="{StaticResource CompactButtonStyle}" Padding="5,1" MinHeight="22" />
                        <Button x:Name="SwitchModuleButton" Content="Cambiar módulo" Click="SwitchModule_Click"
                                Visibility="{Binding SwitchModuleVisibility}" IsEnabled="{Binding CanSwitchModule}"
                                Style="{StaticResource CompactButtonStyle}" Padding="5,1" MinHeight="22" />
                        <Button Content="Cerrar sesión" Click="Logout_Click"
                                Style="{StaticResource CompactButtonStyle}" Padding="5,1" MinHeight="22" Margin="0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                        <Ellipse Width="10" Height="10" Fill="{Binding OutlookStatusBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="Cuenta de envío:" Style="{StaticResource CaptionTextStyle}"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="OutlookAccountSelector" ItemsSource="{Binding OutlookAccounts}"
                                  SelectedItem="{Binding SelectedOutlookAccountEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectionChanged="OutlookAccount_SelectionChanged"
                                  IsEnabled="{Binding CanSelectFile}" Width="230" Height="26" Margin="6,0,0,0"
                                  ToolTip="Seleccione la cuenta local de Outlook que se utilizará para enviar." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,1,0,0">
                        <TextBlock Text="{Binding OutlookStatusText}" Style="{StaticResource CaptionTextStyle}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding OutlookStatusText}"
                                   VerticalAlignment="Center" MaxWidth="340" />
                        <Button x:Name="ConnectOutlookButton" Content="Conectar cuenta" Click="ConnectOutlook_Click"
                                IsEnabled="{Binding CanSelectFile}" Style="{StaticResource CompactButtonStyle}"
                                Padding="5,1" MinHeight="22" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="EmailTemplateCard" Grid.Row="1" Style="{StaticResource CardStyle}"
                Padding="14,9" Margin="0,0,0,8">
            <Grid IsEnabled="{Binding CanConfigureEmail}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="300" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="3*" MinWidth="350" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Plantilla del correo" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="{Binding EmailSettingsStateText}" Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                        <TextBlock Text="Asunto" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock Text="Copias generales" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Height="44" Text="{Binding CommonCcText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" />
                        <TextBlock Text="Separe direcciones con punto y coma, coma o salto de línea."
                                   Style="{StaticResource CaptionTextStyle}" Margin="2,3,0,0" />
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Mensaje" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox Height="120" Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" />
                    <TextBlock Text="El texto conserva los saltos de línea al preparar el correo en Outlook."
                               Style="{StaticResource CaptionTextStyle}" Margin="2,3,0,0" />
                </StackPanel>
                <StackPanel x:Name="SignaturePanel" Grid.Column="4">
                    <TextBlock Text="Firma del correo" Style="{StaticResource FieldLabelTextStyle}" />
                    <Border Height="82" Background="{StaticResource SurfaceMutedBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="7" Padding="8">
                        <Grid>
                            <Image Source="{Binding SignaturePreview}" Stretch="Uniform"
                                   Visibility="{Binding SignaturePreviewVisibility}" />
                            <StackPanel Visibility="{Binding SignatureEmptyVisibility}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE91B;" FontFamily="Segoe Fluent Icons" FontSize="24"
                                           Foreground="{StaticResource DisabledBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Sin firma" Style="{StaticResource CaptionTextStyle}"
                                           TextAlignment="Center" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding SignatureFileName}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding SignatureImagePath}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding SignatureStateText}" Style="{StaticResource CaptionTextStyle}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding SignatureStateText}" />
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Button Content="{Binding SignatureSelectButtonText}" Click="SelectSignature_Click"
                                Style="{StaticResource CompactButtonStyle}" />
                        <Button Content="Quitar" Click="RemoveSignature_Click"
                                IsEnabled="{Binding HasConfiguredSignature}"
                                Style="{StaticResource CompactButtonStyle}" Margin="0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="GenerationSection" Grid.Row="2" Style="{StaticResource CardStyle}"
                Padding="14,10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Reporte general de vencimientos" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock Text="Proceso" Style="{StaticResource FieldLabelTextStyle}" Margin="0,8,0,0" />
                    <ComboBox x:Name="ProcessComboBox" ItemsSource="{Binding ProcessOptions}"
                              SelectedItem="{Binding SelectedProcessOption, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName" IsEnabled="{Binding CanSelectFile}"
                              SelectionChanged="ProcessComboBox_SelectionChanged" />
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0"
                                Visibility="{Binding NextMonthPeriodVisibility}">
                        <ComboBox Width="150" ItemsSource="{Binding MonthOptions}"
                                  SelectedItem="{Binding SelectedMonthOption, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName" SelectionChanged="NextMonthPeriod_Changed" />
                        <TextBox Width="78" Text="{Binding NextMonthYearText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="NextMonthPeriod_Changed" ToolTip="Año" />
                        <Button Content="Prima / Moneda" Click="SelectPremiumColumns_Click"
                                Visibility="{Binding PremiumColumnSelectionVisibility}"
                                IsEnabled="{Binding CanSelectPremiumColumns}"
                                Style="{StaticResource CompactButtonStyle}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SourceFileName}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePath}" />
                    <TextBlock Text="{Binding SourcePath}" Style="{StaticResource CaptionTextStyle}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePath}" Margin="0,2,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="Estado:" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ReportStatusText}" Style="{StaticResource StatusBadgeStyle}" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusDetailText}" Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding GenerationReadinessText}" Style="{StaticResource CaptionTextStyle}"
                               TextWrapping="Wrap" Visibility="{Binding NextMonthPeriodVisibility}" Margin="0,2,0,0" />
                </StackPanel>
                <WrapPanel Grid.Column="3" VerticalAlignment="Center" Margin="16,0,0,0" MaxWidth="430">
                    <Button Content="Seleccionar Excel general" Click="SelectFile_Click"
                            IsEnabled="{Binding CanSelectFile}" />
                    <Button Content="Abrir archivo" Click="OpenSourceFile_Click"
                            IsEnabled="{Binding CanOpenSourceFile}" />
                    <Button Content="Analizar archivo" Click="Analyze_Click"
                            IsEnabled="{Binding CanAnalyze}" />
                    <Button Content="Abrir carpeta" Click="OpenSourceFolder_Click"
                            IsEnabled="{Binding CanOpenSourceFolder}" />
                    <Button Content="Generar archivos" Click="GenerateFiles_Click"
                            IsEnabled="{Binding CanGenerate}" Style="{StaticResource PrimaryButtonStyle}" />
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Buscar corredores o asistentes" Style="{StaticResource FieldLabelTextStyle}" />
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Busca por nombre o correo de corredor y asistente." />
            </StackPanel>
            <Button Grid.Column="1" Content="Configurar corredores" Click="ConfigureBrokers_Click"
                    IsEnabled="{Binding CanConfigureBrokers}" VerticalAlignment="Bottom" Margin="14,0,0,0" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Bottom" Margin="14,0,0,4">
                <TextBlock Text="{Binding BrokerSummaryText}" Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <DataGrid x:Name="BrokerGrid" Grid.Row="4" ItemsSource="{Binding BrokerRowsView}"
                  IsReadOnly="True" AutoGenerateColumns="False" IsEnabled="{Binding CanSelectFile}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="64">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsThreeState="True"
                                          IsChecked="{Binding DataContext.AreAllEligibleSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                                          ToolTip="Marcar o desmarcar todos los corredores elegibles." />
                                <TextBlock Text="Enviar" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanSelectForSend}" ToolTip="{Binding SelectionHint}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Corredor y correo principal" Width="2*" MinWidth="210">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding BrokerName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding PrimaryEmail}" Style="{StaticResource CaptionTextStyle}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding PrimaryEmail}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Asistentes de Vencimientos" Binding="{Binding AssistantsText}"
                                    Width="2*" MinWidth="200" />
                <DataGridTextColumn Header="Registros" Binding="{Binding RowCount}" Width="80" />
                <DataGridTemplateColumn Header="Archivos asociados" Width="135">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FileCountText}" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Estado" Width="135">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusBadgeStyle}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Error o advertencia" Binding="{Binding WarningText}"
                                    Width="2*" MinWidth="180" />
                <DataGridTemplateColumn Header="Acciones" Width="95">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Ver archivos" Click="ViewGeneratedFiles_Click"
                                    IsEnabled="{Binding CanViewFiles}"
                                    Style="{StaticResource CompactButtonStyle}" Margin="0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="5" Style="{StaticResource CardStyle}" Padding="10" Margin="0,8,0,0"
                Visibility="{Binding PendingVisibility}" MaxHeight="160">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Pendientes por resolver" Style="{StaticResource SectionTitleTextStyle}" />
                    <DataGrid ItemsSource="{Binding PendingItems}"
                              SelectedItem="{Binding SelectedPendingIssue, Mode=TwoWay}"
                              IsReadOnly="True" AutoGenerateColumns="False" Height="95" Margin="0,6,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fila" Binding="{Binding RowNumber}" Width="70" />
                            <DataGridTextColumn Header="Valor encontrado" Binding="{Binding RawValue}" Width="2*" />
                            <DataGridTextColumn Header="Estado" Binding="{Binding StatusText}" Width="150" />
                            <DataGridTextColumn Header="Posibles corredores" Binding="{Binding CandidateBrokerNames}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="12,0,0,0">
                    <Button Content="Resolver seleccionado" Click="ResolveSelected_Click"
                            IsEnabled="{Binding CanResolve}" Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Content="Excluir / No corresponde distribución" Click="ExcludeSelected_Click"
                            IsEnabled="{Binding CanExclude}" Style="{StaticResource CompactButtonStyle}" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="BottomActionBar" Grid.Row="6" Style="{StaticResource CardStyle}"
                Padding="14" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel VerticalAlignment="Center">
                    <Button x:Name="NewSendButton" Content="Nuevo envío" Click="NewSend_Click"
                            IsEnabled="{Binding CanSelectFile}" />
                    <Button Content="Guardar" Click="Save_Click" IsEnabled="{Binding CanSave}" />
                    <Button Content="Recargar datos" Click="ReloadData_Click" IsEnabled="{Binding CanSelectFile}" />
                    <Button Content="Ver envíos recientes" Click="OpenSendHistory_Click"
                            IsEnabled="{Binding CanOpenSendHistory}" />
                </WrapPanel>
                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding OperationStatusText}" Style="{StaticResource CaptionTextStyle}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding SendReadinessText}" />
                    <ProgressBar Height="5" Margin="0,5,0,0" IsIndeterminate="{Binding IsBusy}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SendSelectedButton" Content="Enviar seleccionados" Click="SendSelected_Click"
                            IsEnabled="{Binding CanSendSelected}" />
                    <Button x:Name="SendAllButton" Content="Enviar todos" Click="SendAll_Click"
                            IsEnabled="{Binding CanSendAll}"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
