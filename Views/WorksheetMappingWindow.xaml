<Window x:Class="ECS.CommissionsMailer.Views.WorksheetMappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Asociar pestañas" Width="760" Height="540" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterOwner" Style="{StaticResource DialogWindowStyle}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Pestañas sin asociación" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="Asocie cada pestaña a un corredor existente o cree uno nuevo. No se generará ningún archivo hasta completar todas."
                       TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,8">
            <Button Content="Crear corredor" Click="CreateBroker_Click"
                    Style="{StaticResource CompactButtonStyle}" Margin="0" />
        </StackPanel>
        <DataGrid x:Name="MappingsGrid" Grid.Row="2" ItemsSource="{Binding Rows, RelativeSource={RelativeSource AncestorType=Window}}"
                  AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Pestaña" Binding="{Binding WorksheetName}" Width="2*" IsReadOnly="True" />
                <DataGridTemplateColumn Header="Corredor" Width="3*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.AvailableBrokers, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding SelectedBroker, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="IdentityText" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" IsCancel="True" />
            <Button Content="Guardar asociaciones" Click="Save_Click" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
