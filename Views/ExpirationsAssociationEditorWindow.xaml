<Window x:Class="ECS.CommissionsMailer.Views.ExpirationsAssociationEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Asociación de vencimientos"
        Width="620" Height="560" MinWidth="540" MinHeight="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource DialogWindowStyle}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding TitleText}" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="La asociación se utilizará en ambos tipos de Vencimientos."
                       Style="{StaticResource PageSubtitleTextStyle}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock Text="Corredor" Style="{StaticResource CaptionTextStyle}" />
                <TextBlock Text="{Binding BrokerName}" FontWeight="SemiBold" Margin="0,4,0,0" />
                <TextBlock Text="{Binding BrokerEmail}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Tipo" Style="{StaticResource CaptionTextStyle}" />
                <ComboBox ItemsSource="{Binding KindOptions}" SelectedItem="{Binding SelectedKindOption}"
                          DisplayMemberPath="DisplayName" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Valor" Style="{StaticResource CaptionTextStyle}" />
                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="3" Margin="0,12,0,0" TextWrapping="Wrap"
                   Style="{StaticResource MutedTextStyle}"
                   Text="Nombre: nombre alternativo utilizado para identificar al corredor.  Alias: otra forma en que puede aparecer el corredor en el Excel.  Código: código único utilizado para identificar al corredor." />

        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="14" Margin="0,16,0,0"
                VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Resumen antes de guardar" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SummaryValue}" Margin="0,10,0,0" />
                <TextBlock Text="{Binding SummaryKind}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding SummaryBroker}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" IsCancel="True" Style="{StaticResource CompactButtonStyle}" />
            <Button Content="Guardar" Click="Save_Click" IsDefault="True"
                    IsEnabled="{Binding CanSave}" Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
