<Window x:Class="ECS.CommissionsMailer.Views.ExpirationsGeneratedFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Archivos asociados — Vencimientos"
        Icon="pack://application:,,,/Images/icon.ico"
        Width="1120" Height="610" MinWidth="900" MinHeight="460"
        WindowStartupLocation="CenterOwner" Style="{StaticResource DialogWindowStyle}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding TitleText}" Style="{StaticResource PageTitleTextStyle}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding FileCountText}" Style="{StaticResource MutedTextStyle}"
                       Margin="0,5,0,0" />
        </StackPanel>

        <DataGrid x:Name="GeneratedFilesGrid" Grid.Row="1" Margin="0,18,0,0"
                  ItemsSource="{Binding Files}" IsReadOnly="True"
                  RowDetailsVisibilityMode="Collapsed"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Archivo" Width="3*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,5">
                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                           TextWrapping="Wrap" ToolTip="{Binding Path}" />
                                <TextBlock Text="{Binding Path}" Style="{StaticResource CaptionTextStyle}"
                                           TextWrapping="Wrap" ToolTip="{Binding Path}" Margin="0,3,0,0" />
                                <TextBlock Text="{Binding ReviewText}" Style="{StaticResource CaptionTextStyle}"
                                           Foreground="#9A3412" FontWeight="SemiBold" Margin="0,3,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Origen" Binding="{Binding OriginText}" Width="100" />
                <DataGridTextColumn Header="Modificado" Binding="{Binding ModifiedText}" Width="150" />
                <DataGridTemplateColumn Header="Estado" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusText}" Value="Disponible">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Acciones" Width="330">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Ver" Click="ViewFile_Click" CommandParameter="{Binding}"
                                        Style="{StaticResource CompactButtonStyle}" Margin="0" />
                                <Button Content="Editar" Click="EditFile_Click" CommandParameter="{Binding}"
                                        Style="{StaticResource CompactButtonStyle}" />
                                <Button Content="Eliminar de la lista" Click="UnlinkFile_Click"
                                        CommandParameter="{Binding}" Style="{StaticResource CompactButtonStyle}"
                                        Margin="0" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Agregar archivo manual" Click="AddManualFile_Click" MinWidth="170" />
            <Button Content="Cerrar" IsCancel="True" Margin="0" MinWidth="90" />
        </StackPanel>
    </Grid>
</Window>
