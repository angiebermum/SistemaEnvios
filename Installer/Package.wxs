<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="ECS Envío de Correos"
    Manufacturer="Angie Bermúdez"
    Version="$(ProductVersion)"
    Language="3082"
    Codepage="Windows-1252"
    Scope="perMachine"
    InstallerVersion="500"
    UpgradeCode="7BB15A55-BAE3-41CB-963B-E557C1A35182">

    <SummaryInformation
      Description="Instalador de ECS Envío de Correos 1.0.6"
      Manufacturer="Angie Bermúdez"
      Keywords="ECS, correo, Outlook, instalador"
      Comments="Versión 1.0.6 con envío para todos los corredores seleccionados" />

    <MajorUpgrade DowngradeErrorMessage="Ya está instalada una versión más reciente de [ProductName]." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="ECSAppIcon.exe" SourceFile="..\Images\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="ECSAppIcon.exe" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ECS Envío de Correos" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuECSFolder" Name="ECS Envío de Correos" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <Feature
      Id="ApplicationFeature"
      Title="ECS Envío de Correos"
      Description="Archivos completos de la aplicación"
      Level="1"
      AllowAbsent="no"
      AllowAdvertise="no">
      <Files Include="$(PublishDir)\**" Directory="INSTALLFOLDER" />
      <ComponentRef Id="StartMenuShortcutComponent" />
    </Feature>

    <Feature
      Id="DesktopShortcutFeature"
      Title="Acceso directo en el escritorio"
      Description="Crea un acceso directo para iniciar la aplicación desde el escritorio"
      Level="1"
      AllowAbsent="yes"
      AllowAdvertise="no">
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>

    <Component Id="StartMenuShortcutComponent" Directory="ProgramMenuECSFolder" Guid="*">
      <Shortcut
        Id="StartMenuShortcut"
        Name="ECS Envío de Correos"
        Description="ECS Envío de Correos"
        Target="[INSTALLFOLDER]ECS Envío de Correos.exe"
        WorkingDirectory="INSTALLFOLDER"
        Icon="ECSAppIcon.exe" />
      <RemoveFolder Id="RemoveProgramMenuFolder" Directory="ProgramMenuECSFolder" On="uninstall" />
      <RegistryValue
        Root="HKCU"
        Key="Software\Angie Bermúdez\ECS Envío de Correos"
        Name="StartMenuShortcut"
        Type="integer"
        Value="1"
        KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcutComponent" Directory="DesktopFolder" Guid="*">
      <Shortcut
        Id="DesktopShortcut"
        Name="ECS Envío de Correos"
        Description="ECS Envío de Correos"
        Target="[INSTALLFOLDER]ECS Envío de Correos.exe"
        WorkingDirectory="INSTALLFOLDER"
        Icon="ECSAppIcon.exe" />
      <RegistryValue
        Root="HKCU"
        Key="Software\Angie Bermúdez\ECS Envío de Correos"
        Name="DesktopShortcut"
        Type="integer"
        Value="1"
        KeyPath="yes" />
    </Component>

    <UIRef Id="ECSInstallUI" />
    <UIRef Id="WixUI_ErrorProgressText" />
  </Package>
</Wix>
