<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <Cultures>es-ES</Cultures>
    <OutputName>ECS Envío de Correos - Instalador $(EcsApplicationVersion)</OutputName>
    <ApplicationPublishDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\artifacts\publish\win-x64'))</ApplicationPublishDirectory>
    <DefineConstants>PublishDir=$(ApplicationPublishDirectory);ProductVersion=$(EcsApplicationVersion)</DefineConstants>
    <DefaultCompressionLevel>high</DefaultCompressionLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>

  <Target Name="PublishApplication" BeforeTargets="BeforeBuild" Condition="'$(SkipApplicationPublish)' != 'true'">
    <RemoveDir Directories="$(ApplicationPublishDirectory)" />
    <MakeDir Directories="$(ApplicationPublishDirectory)" />
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\ECS.CommissionsMailer.csproj&quot; --configuration Release --runtime win-x64 --self-contained true --property:PublishDir=&quot;$(ApplicationPublishDirectory)&quot; --property:PublishTrimmed=false --property:PublishSingleFile=false" />
    <Error Condition="!Exists('$(ApplicationPublishDirectory)\ECS Envío de Correos.exe')" Text="No se encontró la publicación autocontenida de ECS Envío de Correos." />
    <Error Condition="!Exists('$(ApplicationPublishDirectory)\Data\correos-iniciales.v3.json')" Text="No se encontró el directorio inicial de correos en la publicación." />
    <Error Condition="!Exists('$(ApplicationPublishDirectory)\Data\firma-inicial.png')" Text="No se encontró la firma requerida por el directorio inicial de correos en la publicación." />
  </Target>
</Project>
