<Window x:Class="ECS.CommissionsMailer.Views.AssistantEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Asistente"
        Width="520" Height="340" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindowStyle}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Datos del asistente" Style="{StaticResource PageTitleTextStyle}" />
        <TextBlock Grid.Row="1" Text="El asistente recibirá el mismo correo y los mismos archivos del corredor."
                   Style="{StaticResource MutedTextStyle}" Margin="0,4,0,18" />
        <StackPanel Grid.Row="2">
            <TextBlock Text="Nombre" Style="{StaticResource FieldLabelTextStyle}" />
            <TextBox x:Name="NameTextBox" MaxLength="160" TabIndex="0" />
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="Correo electrónico" Style="{StaticResource FieldLabelTextStyle}" />
            <TextBox x:Name="EmailTextBox" MaxLength="254" TabIndex="1" />
        </StackPanel>
        <ToggleButton x:Name="ActiveCheckBox" Grid.Row="4" Content="Asistente activo" IsChecked="True"
                      Style="{StaticResource SwitchToggleButtonStyle}"
                      Margin="0,16,0,0" VerticalAlignment="Top" TabIndex="2" />
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" IsCancel="True" TabIndex="4" />
            <Button Content="Guardar asistente" Click="Save_Click" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" Margin="0" TabIndex="3" />
        </StackPanel>
    </Grid>
</Window>
