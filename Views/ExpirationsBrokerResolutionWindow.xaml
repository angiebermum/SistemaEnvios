<Window x:Class="ECS.CommissionsMailer.Views.ExpirationsBrokerResolutionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resolver corredor"
        Width="680" SizeToContent="Height" MaxHeight="660" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindowStyle}">
    <Border Style="{StaticResource CardStyle}" Margin="16" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Resolver corredor" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Confirme el corredor que corresponde al valor encontrado."
                           Style="{StaticResource PageSubtitleTextStyle}" Margin="0,5,0,0" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource WarningPanelStyle}" Margin="0,18,0,0"
                    Visibility="{Binding AmbiguityWarningVisibility}">
                <TextBlock Text="Este valor está asociado a más de un corredor. La selección se aplicará únicamente a esta fila y no se guardará como asociación permanente."
                           TextWrapping="Wrap" />
            </Border>

            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Fila" Style="{StaticResource CaptionTextStyle}" />
                <TextBlock Grid.Column="1" Text="{Binding Issue.RowNumber}" />
                <TextBlock Grid.Row="1" Text="Valor" Style="{StaticResource CaptionTextStyle}" Margin="0,10,0,0" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Issue.RawValue}" TextWrapping="Wrap"
                           Margin="0,10,0,0" FontWeight="SemiBold" />
            </Grid>

            <StackPanel Grid.Row="3" Margin="0,18,0,0">
                <TextBlock Text="Seleccione el corredor" Style="{StaticResource CaptionTextStyle}" />
                <ComboBox ItemsSource="{Binding Brokers}" SelectedItem="{Binding SelectedBroker, Mode=TwoWay}"
                          DisplayMemberPath="DisplayText" Margin="0,5,0,0" MaxDropDownHeight="240" />
                <TextBlock Text="El corredor debe registrarse primero en ECS si no aparece en esta lista."
                           Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,14,0,0" Visibility="{Binding AssociationTypeVisibility}">
                <TextBlock Text="Tipo de asociación" Style="{StaticResource CaptionTextStyle}" />
                <ComboBox ItemsSource="{Binding KindOptions}" SelectedItem="{Binding SelectedKind, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName" Margin="0,5,0,0" />
                <TextBlock Text="{Binding AssociationHelpText}" Style="{StaticResource MutedTextStyle}"
                           TextWrapping="Wrap" Margin="0,5,0,0" />
            </StackPanel>

            <Border Grid.Row="5" Style="{StaticResource CardStyle}" Padding="12" Margin="0,14,0,0"
                    Visibility="{Binding AssociationTypeVisibility}">
                <StackPanel>
                    <TextBlock Text="Confirmación de la asociación" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ConfirmationSummary}" TextWrapping="Wrap" Margin="0,5,0,0" />
                    <TextBlock Text="Esta asociación se utilizará en ambos tipos de Vencimientos."
                               Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Cancelar" IsCancel="True" Style="{StaticResource CompactButtonStyle}" />
                <Button Content="{Binding ConfirmButtonText}" Click="Confirm_Click" IsDefault="True"
                        IsEnabled="{Binding CanConfirm}" Style="{StaticResource PrimaryButtonStyle}" Margin="0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
