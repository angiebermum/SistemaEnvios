<Window x:Class="ECS.CommissionsMailer.Views.ResendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Envíos recientes y reenvío"
        Width="900" Height="700" MinWidth="760" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindowStyle}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Envíos recientes" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Revise el destinatario principal junto al nombre antes de crear un correo corregido."
                           Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <Button x:Name="ClearHistoryButton" Grid.Column="1" Content="Limpiar historial"
                    Click="ClearHistory_Click" Style="{StaticResource DangerButtonStyle}"
                    Margin="16,0,0,0" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="Envío anterior" Style="{StaticResource FieldLabelTextStyle}" VerticalAlignment="Center" />
            <ComboBox x:Name="RecordsComboBox" Grid.Column="1" DisplayMemberPath="DisplayText"
                      SelectionChanged="Record_SelectionChanged" TabIndex="0" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Corredor" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBox x:Name="BrokerTextBox" Grid.Column="1" IsReadOnly="True" IsTabStop="False" Background="{StaticResource SurfaceMutedBrush}" />
                <TextBlock Grid.Row="1" Text="Para" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,10,0,0" />
                <TextBox x:Name="ToTextBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" IsTabStop="False"
                         Background="{StaticResource SurfaceMutedBrush}" Margin="0,10,0,0" />
                <TextBlock Grid.Row="2" Text="CC" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,10,0,0" />
                <TextBox x:Name="CcTextBox" Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" TabIndex="1" />
                <TextBlock Grid.Row="3" Text="Asunto" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,10,0,0" />
                <TextBox x:Name="SubjectTextBox" Grid.Row="3" Grid.Column="1" Margin="0,10,0,0" TabIndex="2" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource InfoPanelStyle}" Margin="0,12,0,0">
            <TextBlock Text="Se usa la relación actual de asistentes y la firma global actual. El mensaje original y su registro histórico no se modifican."
                       TextWrapping="Wrap" Foreground="{StaticResource PrimaryDarkBrush}" />
        </Border>

        <Grid Grid.Row="4" Margin="0,16,0,7">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Archivos de Excel" Style="{StaticResource SectionTitleTextStyle}" />
                <TextBlock Text="La firma inline no forma parte de esta lista." Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Agregar archivo" Click="AddAttachment_Click" Margin="0" VerticalAlignment="Bottom" />
        </Grid>

        <ListBox x:Name="AttachmentsList" Grid.Row="5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                 Background="{StaticResource SurfaceBrush}" TabIndex="3">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="8,5">
                        <Button DockPanel.Dock="Right" Content="Quitar" Click="RemoveAttachment_Click"
                                Style="{StaticResource CompactButtonStyle}" Margin="8,0,0,0" />
                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding}" />
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="6" Margin="0,10,0,0"
                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />

        <StackPanel x:Name="CommandPanel" Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cerrar" IsCancel="True" TabIndex="5" />
            <Button Content="Reenviar correo" Click="Resend_Click" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" Margin="0" MinWidth="130" TabIndex="4" />
        </StackPanel>
    </Grid>
</Window>
