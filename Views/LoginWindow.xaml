<Window x:Class="ECS.CommissionsMailer.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iniciar sesión — Essential Corredora de Seguros"
        Icon="pack://application:,,,/Images/icon.ico"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource DialogWindowStyle}">
    <Border Style="{StaticResource CardStyle}" Margin="16" Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Essential Corredora de Seguros" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Por favor ingrese su usuario y contraseña."
                           Style="{StaticResource PageSubtitleTextStyle}" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,24,0,0">
                <TextBlock Text="Correo electrónico" Style="{StaticResource FieldLabelTextStyle}" />
                <TextBox x:Name="EmailTextBox" Margin="0,6,0,0" AutomationProperties.Name="Correo electrónico" />
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <TextBlock Text="Contraseña" Style="{StaticResource FieldLabelTextStyle}" />
                <Grid Margin="0,6,0,0">
                    <PasswordBox x:Name="PasswordBox" MinHeight="34" Padding="9,7"
                                 AutomationProperties.Name="Contraseña" KeyDown="PasswordInput_KeyDown"
                                 PasswordChanged="PasswordBox_PasswordChanged" />
                    <TextBox x:Name="VisiblePasswordTextBox" MinHeight="34" Padding="9,7"
                             AutomationProperties.Name="Contraseña visible" KeyDown="PasswordInput_KeyDown"
                             TextChanged="VisiblePasswordTextBox_TextChanged" Visibility="Collapsed" />
                </Grid>
                <CheckBox x:Name="ShowPasswordCheckBox" Content="Mostrar contraseña" Margin="0,8,0,0"
                          AutomationProperties.Name="Mostrar contraseña"
                          Checked="ShowPasswordCheckBox_Checked" Unchecked="ShowPasswordCheckBox_Unchecked" />
            </StackPanel>
            <TextBlock x:Name="StatusTextBlock" Grid.Row="3" Margin="0,16,0,0"
                       TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
            <Grid Grid.Row="4" Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ResetButton" Content="Olvidé mi contraseña" Click="ResetPassword_Click"
                        Style="{StaticResource CompactButtonStyle}" HorizontalAlignment="Left" />
                <Button x:Name="SignInButton" Grid.Column="1" Content="Iniciar sesión" Click="SignIn_Click"
                        Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" MinWidth="120" IsDefault="True" />
            </Grid>
        </Grid>
    </Border>
</Window>
