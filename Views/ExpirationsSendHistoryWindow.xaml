<Window x:Class="ECS.CommissionsMailer.Views.ExpirationsSendHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historial de envíos — Vencimientos"
        Width="1120" Height="760" MinWidth="940" MinHeight="640"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded"
        Style="{StaticResource DialogWindowStyle}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Historial de envíos" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="Cada fila representa una pulsación confirmada de Enviar. Las operaciones incompletas tienen resultado no confirmado."
                       Style="{StaticResource PageSubtitleTextStyle}" Margin="0,4,0,0" />
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Operations}" SelectedItem="{Binding SelectedOperation, Mode=TwoWay}"
                  SelectionChanged="Operations_SelectionChanged" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" Margin="0,16,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha" Binding="{Binding DateText}" Width="140" />
                <DataGridTextColumn Header="Proceso" Binding="{Binding ProcessText}" Width="180" />
                <DataGridTextColumn Header="Cuenta" Binding="{Binding Account}" Width="250" />
                <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="60" />
                <DataGridTextColumn Header="Exitosos" Binding="{Binding Successes}" Width="75" />
                <DataGridTextColumn Header="Fallidos" Binding="{Binding Failures}" Width="70" />
                <DataGridTextColumn Header="Estado" Binding="{Binding StatusText}" Width="240" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Text="Detalle de correos" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,6" />

        <DataGrid Grid.Row="3" ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Corredor" Binding="{Binding BrokerName}" Width="190" />
                <DataGridTextColumn Header="Para" Binding="{Binding ToText}" Width="240" />
                <DataGridTextColumn Header="Archivo(s)" Binding="{Binding FilesText}" Width="230" />
                <DataGridTextColumn Header="Estado" Binding="{Binding StatusText}" Width="160" />
                <DataGridTextColumn Header="Error" Binding="{Binding ErrorText}" Width="220" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding RetryStatusText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cerrar" Click="Close_Click" IsEnabled="{Binding CanClose}"
                        Style="{StaticResource CompactButtonStyle}" />
                <Button Content="Reintentar fallidos" Click="RetryFailed_Click" IsEnabled="{Binding CanRetry}"
                        Style="{StaticResource PrimaryButtonStyle}" Margin="0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
